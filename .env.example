# ══════════════════════════════════════════════════════════
# VIDEO EDITOR PORTFOLIO — ENVIRONMENT VARIABLES
# ══════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# ══════════════════════════════════════════════════════════

# ─── DATABASE ─────────────────────────────────────────────
# SQLite (local dev — zero setup):
DATABASE_URL=file:./prisma/dev.db
# PostgreSQL for production (Neon / Supabase / Railway):
# DATABASE_URL=postgresql://USER:PASSWORD@host:5432/portfolio?sslmode=require

# ─── AUTHENTICATION ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-super-secret-key-change-this-in-production





# ─── NEXT.JS ──────────────────────────────────────────────
# Set to your production domain in deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── EMAIL (Gmail + Nodemailer) ────────────────────────────
# Contact form sends emails via your Gmail account.
# GMAIL_USER:         your Gmail address
# GMAIL_APP_PASSWORD: 16-char App Password (NOT your real password)
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. App = Mail → Other → type "Portfolio" → Generate
# GMAIL_SENDER_NAME:  Display name shown in recipient's inbox
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_SENDER_NAME=Your Name
